{
	"name": "itsblue-scstw",
	"version": "0.1.3",
	"description": "Companion integration for the itsblue.de speedclimbing stopwatch (ScStw)",
	"main": "scstw-streamdeck/packages/companion/dist/main.js",
	"type": "module",
	"workspaces": [
		"packages/companion",
		"packages/core",
		"packages/renderer"
	],
	"scripts": {
		"build": "yarn check:sync-submodule && yarn workspace @itsblue/scstw-streamdeck-core build && yarn workspace @itsblue/scstw-streamdeck-renderer build && yarn workspace @itsblue/scstw-streamdeck-companion build",
		"check:sync-submodule": "node scripts/sync-submodule.mjs --check",
		"package": "yarn build && companion-module-build",
		"sync-submodule": "node scripts/sync-submodule.mjs"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-itsblue-scstw.git"
	},
	"bugs": "https://github.com/bitfocus/companion-module-itsblue-scstw/issues",
	"dependencies": {
		"@companion-module/base": "2.0.4"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.1",
		"eslint": "^10.0.1",
		"prettier": "^3.8.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.17.0"
}